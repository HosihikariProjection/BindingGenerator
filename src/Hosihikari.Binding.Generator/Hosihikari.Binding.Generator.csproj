<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.Binding.Generator</RootNamespace>
    <AssemblyName>Hosihikari.Binding.Generator</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Generates C ABI BindingShim and native-style .NET Interop from versioned IR.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/BindingGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;binding;interop;hosihikari</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Binding.Ir/src/Hosihikari.Binding.Ir/Hosihikari.Binding.Ir.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read at plan time; see AbiPlan.UnexportedMembers for the format and the carrier pin. -->
    <None Update="unexported-levilamina.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
