<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InteropDirectory Condition="'$(InteropDirectory)' == ''"
      >$(MSBuildThisFileDirectory)..\..\artifacts\emitted-linked\interop</InteropDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(InteropDirectory)/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Binding.Abi/src/Hosihikari.Binding.Abi/Hosihikari.Binding.Abi.csproj" />
  </ItemGroup>
</Project>
